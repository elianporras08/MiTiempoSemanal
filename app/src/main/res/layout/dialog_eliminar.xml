<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/fondo_oscuro">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ ELIMINAR ]"
        android:textColor="@color/blanco_pixel"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvMensajeEliminar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Estás seguro?"
        android:textColor="@color/blanco_pixel"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelarEliminar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CANCELAR"
            android:textColor="@color/blanco_pixel"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnConfirmarEliminar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ELIMINAR"
            android:textColor="@color/fondo_oscuro"
            android:backgroundTint="@color/blanco_pixel"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>