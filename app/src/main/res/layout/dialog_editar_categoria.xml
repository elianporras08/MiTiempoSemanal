<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/fondo_oscuro">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ EDITAR CATEGORÍA ]"
        android:textColor="@color/blanco_pixel"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etEditarNombreCategoria"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="NUEVO NOMBRE_"
        android:textColorHint="@color/gris_medio"
        android:textColor="@color/blanco_pixel"
        android:backgroundTint="@color/blanco_pixel"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:layout_marginBottom="24dp"/>

    <!-- Fila de botones optimizada para dar prioridad al botón de actualizar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnCancelarEditarCat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCELAR"
            android:textColor="@color/blanco_pixel"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnConfirmarEditarCat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ACTUALIZAR"
            android:textColor="@color/fondo_oscuro"
            android:backgroundTint="@color/blanco_pixel"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
</LinearLayout>