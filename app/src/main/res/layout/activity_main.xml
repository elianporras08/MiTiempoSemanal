<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/fondo_oscuro">

    <!-- Contenedor interno centrado con márgenes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MI TIEMPO SEMANAL"
            android:textAlignment="center"
            android:textColor="@color/blanco_pixel"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:layout_marginBottom="50dp" />

        <Button
            android:id="@+id/btnCategorias"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="> GESTIONAR CATEGORÍAS"
            android:textColor="@color/fondo_oscuro"
            android:backgroundTint="@color/blanco_pixel"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnTareas"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="> GESTIONAR TAREAS"
            android:textColor="@color/fondo_oscuro"
            android:backgroundTint="@color/blanco_pixel"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp"
            android:stateListAnimator="@null" />

        <!-- Nuevo botón para el Calendario (Sprint 2) -->
        <Button
            android:id="@+id/btnCalendario"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="> GESTIONAR CALENDARIO"
            android:textColor="@color/fondo_oscuro"
            android:backgroundTint="@color/blanco_pixel"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="48dp"
            android:stateListAnimator="@null" />

        <!-- Versión actualizada a v0.2.0 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ Elian Porras · v0.2.0 ]"
            android:textColor="@color/blanco_pixel"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>