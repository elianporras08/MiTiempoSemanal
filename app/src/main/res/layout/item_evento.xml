<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#161616"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvItemTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre Tarea"
        android:textColor="@color/blanco_pixel"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"/>

    <TextView
        android:id="@+id/tvItemCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Categoría: Estudio"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginTop="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvItemHorarios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inicio: 10:00 - Fin: 11:30"
            android:textColor="@color/blanco_pixel"
            android:textSize="11sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/tvItemDuracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1h 30m"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>
    </LinearLayout>
</LinearLayout>